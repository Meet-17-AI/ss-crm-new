# ============================================================
# SafeStories CRM — Environment Variables for Render Deployment
# ============================================================
# Copy this file to .env on your Render service and fill in values.
# DO NOT commit .env to git — keep .env.example instead.

# ─── Node Environment ──────────────────────────────────────
NODE_ENV=production

# ─── Database (PostgreSQL) ─────────────────────────────────
# Your hosted PostgreSQL connection details
PGHOST=72.60.103.151
PGPORT=5432
PGDATABASE=safestories_db
PGUSER=fluidadmin
PGPASSWORD=your_db_password_here

# Aliases used in some files (same DB, both needed)
DB_HOST=72.60.103.151
DB_PORT=5432
DB_NAME=safestories_db
DB_USER=fluidadmin
DB_PASSWORD=your_db_password_here

# ─── Frontend URL ──────────────────────────────────────────
# The URL where your CRM frontend is deployed (Vercel / Render static)
FRONTEND_URL=https://crm.safestories.in

# ─── Gmail (for email notifications) ──────────────────────
# Use a Gmail account with App Password enabled
# Google Account → Security → 2FA → App Passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── MinIO (file storage for uploads) ─────────────────────
MINIO_ENDPOINT=s3.srv1169280.hstgr.cloud
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_here
MINIO_BUCKET_NAME=safestories-panel

# ─── Razorpay (payments) ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─── n8n Webhooks ─────────────────────────────────────────
# All n8n automation webhook URLs — get these from your n8n instance
N8N_WEBHOOK_FETCH_SLOTS_PUBLIC=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_FETCH_SLOTS_PUBLIC_ID
N8N_WEBHOOK_FETCH_SLOTS_ADMIN_DIRECT=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_FETCH_SLOTS_ADMIN_DIRECT_ID
N8N_WEBHOOK_FETCH_SLOTS_ADMIN_PAYMENT=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_FETCH_SLOTS_ADMIN_PAYMENT_ID
N8N_WEBHOOK_CREATE_BOOKING_PUBLIC=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_CREATE_BOOKING_PUBLIC_ID
N8N_WEBHOOK_CREATE_BOOKING_ADMIN_DIRECT=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_CREATE_BOOKING_ADMIN_DIRECT_ID
N8N_WEBHOOK_CANCEL_BOOKING=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_CANCEL_BOOKING_ID
N8N_WEBHOOK_RESCHEDULE_BOOKING=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_RESCHEDULE_ID
N8N_WEBHOOK_ISSUE_REPORT=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_ISSUE_REPORT_ID
N8N_WEBHOOK_SOS_EMAIL=https://n8n.srv1169280.hstgr.cloud/webhook/YOUR_SOS_EMAIL_ID
