# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package*.json ./

# Install root dependencies
RUN npm ci

# Copy the rest of the application files
COPY . .

# Install crm-backend dependencies
WORKDIR /app/crm-backend
RUN npm ci

# Set working directory back to root
WORKDIR /app

# Expose the ports for both backends
# 3002 is no longer used: server/index.ts, the stale fork that listened on it,
# is no longer started. See the router note in docker-compose.yml.
EXPOSE 3003

# Command to run both servers and the sync daemon concurrently
CMD ["npm", "run", "server"]
