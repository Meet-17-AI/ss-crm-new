{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ss-crm-backend.onrender.com/api/:path*" },
    { "source": "/sos-view/:token", "destination": "/index.html" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
